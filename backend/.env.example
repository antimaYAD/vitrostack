# Optional: enables Gemini function calling for VitroCore. Without it the offline planner is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: real WhatsApp Business API. Without these, messages are simulated in Site Ops.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=vitrostack-verify

# Defaults to SQLite; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/vitrostack)
DATABASE_URL=sqlite:///./vitrostack.db
VITRO_STORAGE=./storage

# Authentication. On first start, if ADMIN_EMAIL/ADMIN_PASSWORD are set, that admin is created;
# otherwise demo accounts are created (admin@vitrostack.local / admin123, estimator@vitrostack.local / estimator123).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set DEMO_MODE=0 to hide the demo-account shortcuts on the sign-in page.
DEMO_MODE=1
# Set ALLOW_SIGNUP=0 to disable self-service company sign-up at /register.
ALLOW_SIGNUP=1
# Set COOKIE_SECURE=1 when served over HTTPS.
COOKIE_SECURE=0
