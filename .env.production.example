# Copy to .env for docker compose, or enter these as environment variables on your host.

# Database. docker compose builds DATABASE_URL from POSTGRES_PASSWORD; on a host, set DATABASE_URL to the
# Postgres URL it gives you (postgres://... and postgresql://... are both accepted).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:password@host:5432/vitrostack

# First admin, created on the first start against an empty database. Change the password after signing in.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-too
# Platform owner: creates companies and their admins (Companies page). Created on start if the email is unused.
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=use-a-long-unique-password
# Name of the first company (the one ADMIN_EMAIL belongs to).
COMPANY_NAME=Your Company Pvt Ltd

# Production switches
# DEMO_MODE=0: no demo accounts or demo projects, no demo-login shortcuts.
DEMO_MODE=0
# There is no self sign-up: the superadmin creates companies, company admins add their users.
# COOKIE_SECURE=1 needs HTTPS. Set it to 0 only when testing over plain http://localhost.
COOKIE_SECURE=1

# Optional integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
